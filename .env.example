# ─────────────────────────────────────────────────────────────
# 네스트 백엔드 환경변수 — 값이 아니라 "목록"이 단일 출처다.
#
# 이 파일의 존재 이유(2026-09-16): Railway 첫 배포에서 환경변수 누락으로
# 부팅이 6회 연속 실패했다. 매번 로그를 보고 하나씩 찾아 넣는 식이었고,
# 근본 원인은 application.yaml의 ${...} 목록을 먼저 정리하지 않은 것이었다.
# 새 ${ENV_VAR}를 application.yaml에 추가하면 이 파일에도 같이 추가할 것.
#
# ⚠️ 실제 값은 절대 여기 적지 않는다. 이 파일은 커밋되고, 값은 커밋 금지다.
# ─────────────────────────────────────────────────────────────

# ── ★필수: 하나라도 없으면 애플리케이션이 부팅되지 않는다 ──────────
# (application.yaml에서 기본값 없이 ${VAR}로만 선언된 것들)

# HS256 서명키. 32바이트 이상. 생성: openssl rand -base64 48
JWT_SECRET=

# users 테이블 name/phone/birth_date 컬럼의 AES-256-GCM 키(base64 32바이트).
# 생성: openssl rand -base64 32
# ⚠️ 이 값을 잃으면 기존 암호화 데이터는 영구 복구 불가다. 별도 백업 필수.
PII_ENCRYPTION_KEY=

# 카카오 개발자센터 > 앱 키 > REST API 키.
# 설계상 공개값이다(인증 URL 쿼리스트링에 그대로 노출됨) — 시크릿이 아니다.
KAKAO_CLIENT_ID=

# 공공데이터포털(data.go.kr) — 국내주식·ETF 시세
DATA_GO_KR_API_KEY=

# Finnhub — 해외주식 시세
FINNHUB_API_KEY=

# 한국수출입은행 — 환율
KOREAEXIM_API_KEY=

# ── 배포 환경에서 사실상 필수(기본값이 로컬/타 서비스 전용이라 반드시 덮어야 함) ──

# Postgres 접속 정보. Railway에서는 ${{Postgres.*}} 참조로 연결한다.
# ⚠️ 변수명이 SPRING_DATASOURCE_* 가 아니다. yaml이 이 이름으로 읽는다.
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# 프론트 도메인. 쉼표 구분 다중 가능.
# ⚠️ 빠뜨리면 프론트의 모든 요청이 CORS로 막힌다(D-225).
# ⚠️ SecurityConfig가 allowCredentials(true)라 와일드카드(*.vercel.app)를 쓸 수 없다
#    — 그래서 Vercel 프리뷰 배포는 CORS에 막힌다. 프로덕션 도메인만 등록할 것.
# ⚠️ 기동 시 바인딩이라 값만 바꾸고 재기동하지 않으면 반영되지 않는다.
APP_CORS_ALLOWED_ORIGINS=

# 카카오 로그인 성공 후 돌려보낼 프론트 주소. 예: https://<도메인>/auth/callback
FRONTEND_CALLBACK_URL=

# 은퇴 시뮬레이션 결과 "공유하기" 문구에 들어가는 주소.
# ⚠️ 기본값(retirement-planner.vercel.app)은 이 프로젝트가 아닌 남의 서비스다(D-190).
#    운영에서 반드시 덮어쓸 것.
APP_SHARE_URL=

# 프록시(Railway/Vercel) 뒤에서 X-Forwarded-Proto를 신뢰해 https로 URL을 조립한다.
# ⚠️ 없으면 카카오 redirect_uri가 http로 만들어져 KOE006으로 로그인이 실패한다.
SERVER_FORWARD_HEADERS_STRATEGY=framework

# ── 선택: 기본값으로 동작하며, 켤 때만 지정한다 ────────────────────

# 평문으로 남아 있는 기존 PII를 1회성으로 암호화하는 러너 스위치.
# 마이그레이션 직후 true로 1회 기동 → 즉시 false로 되돌린다(D-165).
PII_MIGRATION_ENABLED=false

# OpenDART — 배당 공시. 미발급 상태라 비워두면 해당 기능만 degrade된다(D-152).
OPENDART_API_KEY=

# 네이버 클라우드 SENS — 휴대폰 인증 SMS. 벤더 미계약이라 기본 비활성(D-150).
SENS_ENABLED=false
SENS_ACCESS_KEY=
SENS_SECRET_KEY=
SENS_SERVICE_ID=
SENS_SENDER_PHONE=

# 관리자 API(/api/admin/**) 노출 스위치. 기본 false = denyAll.
# 마스터 갱신(환율/ETF/종목/법인코드) 4건은 모두 @Scheduled로도 돌기 때문에
# 막아도 운영 기능은 유지된다. users에 역할 컬럼이 없어서 켜면 "로그인한 사용자 전원"이
# 호출할 수 있게 되므로, 운영에서는 설정하지 말 것(= 기본 false 유지).
ADMIN_API_ENABLED=false

# ── 설정하면 안 되는 것 ──────────────────────────────────────────
#
# SPRING_JPA_HIBERNATE_DDL_AUTO
#   스키마는 Flyway가 단독으로 관리한다(D-080). yaml의 validate를 운영에서
#   update로 덮으면 Hibernate가 스키마를 추가로 변경해 운영 DB가
#   db/migration/ 파일들로 재현되지 않게 된다.
#   빈 DB에 Flyway 18개 적용 후 validate로 정상 부팅되는 것을 확인했으므로
#   (2026-09-16) 이 변수는 운영에 존재해서는 안 된다.
#   validate가 실패한다면 그 에러 원문이 곧 다음 V## 마이그레이션의 내용이다.
